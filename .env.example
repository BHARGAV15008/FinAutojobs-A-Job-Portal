# ***************************************************************************************************
# FinAutoJobs - Unified Environment Configuration
# ***************************************************************************************************
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control
# This single file contains ALL environment variables for the entire project

# ***************************************************************************************************
# SERVER CONFIGURATION
# ***************************************************************************************************
PORT=5000
NODE_ENV=development
BACKEND_PORT=5000

# ***************************************************************************************************
# DATABASE CONFIGURATION
# ***************************************************************************************************
MONGODB_URI=mongodb+srv://technogenius1500_db_user:ZnqBQD8wc4M6c1Fm@cluster0.slmyrux.mongodb.net/?appName=Cluster0
DATABASE_URL=mongodb+srv://technogenius1500_db_user:ZnqBQD8wc4M6c1Fm@cluster0.slmyrux.mongodb.net/?appName=Cluster0

# ***************************************************************************************************
# FRONTEND CONFIGURATION
# ***************************************************************************************************
FRONTEND_URL=http://192.168.41.134:3000
VITE_API_URL=http://192.168.41.134:5000/api
VITE_BACKEND_PORT=5000
VITE_API_PORT=5000
VITE_PROD_API_URL=/api

# ***************************************************************************************************
# AUTHENTICATION & SECURITY
# ***************************************************************************************************
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-123456789
JWT_EXPIRES_IN=24h
SESSION_SECRET=your-session-secret-key-change-this-in-production-987654321

# ***************************************************************************************************
# OAUTH CONFIGURATION
# ***************************************************************************************************
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=/api/auth/google/callback

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=/api/auth/microsoft/callback

# Apple OAuth
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./apple-private-key.p8
APPLE_CALLBACK_URL=/api/auth/apple/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_CALLBACK_URL=/api/auth/linkedin/callback

# ***************************************************************************************************
# FIREBASE CONFIGURATION
# ***************************************************************************************************
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-firebase-private-key-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_CLIENT_ID=your-firebase-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_CLIENT_X509_CERT_URL=your-firebase-client-cert-url

# ***************************************************************************************************
# EMAIL CONFIGURATION
# ***************************************************************************************************
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM_NAME=FinAutoJobs
EMAIL_FROM_ADDRESS=your-email@gmail.com
SEND_EMAILS_IN_DEV=true

# ***************************************************************************************************
# OTP CONFIGURATION
# ***************************************************************************************************
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_ENABLED=true

# ***************************************************************************************************
# CORS CONFIGURATION
# ***************************************************************************************************
CORS_ORIGINS=http://192.168.41.134:3000,http://127.0.0.1:3000
CORS_ORIGIN=http://192.168.41.134:3000
CORS_CREDENTIALS=true

# ***************************************************************************************************
# ADMIN CONFIGURATION
# ***************************************************************************************************
ADMIN_EMAIL=admin@finautojobs.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Super Admin

# ***************************************************************************************************
# LOGGING CONFIGURATION
# ***************************************************************************************************
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log
DEBUG_MODE=true

# ***************************************************************************************************
# PERFORMANCE CONFIGURATION
# ***************************************************************************************************
DB_POOL_SIZE=10
DB_POOL_MAX_WAITING_TIME=30000
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ***************************************************************************************************
# FEATURE FLAGS
# ***************************************************************************************************
ENABLE_REGISTRATION=true
ENABLE_COMPANY_VERIFICATION=true
ALLOW_UNVERIFIED_JOB_POSTING=false
REQUIRE_PROFILE_COMPLETION=true
ENABLE_SOCKET_IO=true

# ***************************************************************************************************
# SECURITY HEADERS
# ***************************************************************************************************
CSP_DEFAULT_SRC="'self'"
CSP_SCRIPT_SRC="'self' 'unsafe-inline' 'unsafe-eval'"
CSP_STYLE_SRC="'self' 'unsafe-inline'"
CSP_IMG_SRC="'self' data: https:"
CSP_FONT_SRC="'self' data: https:"
CSP_CONNECT_SRC="'self' ws: wss:"

# ***************************************************************************************************
# HEALTH CHECK CONFIGURATION
# ***************************************************************************************************
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# ***************************************************************************************************
# DATA RETENTION & COMPLIANCE
# ***************************************************************************************************
DATA_RETENTION_DAYS=365
ENABLE_DATA_EXPORT=true
ENABLE_DATA_DELETION=true
AUTO_DELETE_INACTIVE_ACCOUNTS=true
INACTIVE_ACCOUNT_DAYS=365

# ***************************************************************************************************
# PLATFORM BRANDING
# ***************************************************************************************************
PLATFORM_NAME=FinAutoJobs
PLATFORM_TAGLINE=Connecting Talent with Opportunity
PLATFORM_LOGO=/assets/logo.png
PLATFORM_FAVICON=/assets/favicon.ico
SUPPORT_EMAIL=support@finautojobs.com
SUPPORT_PHONE=+1-555-123-4567

# ***************************************************************************************************
# SOCIAL MEDIA LINKS
# ***************************************************************************************************
SOCIAL_FACEBOOK=https://facebook.com/finautojobs
SOCIAL_TWITTER=https://twitter.com/finautojobs
SOCIAL_LINKEDIN=https://linkedin.com/company/finautojobs
SOCIAL_INSTAGRAM=https://instagram.com/finautojobs

# ***************************************************************************************************
# TESTING CONFIGURATION
# ***************************************************************************************************
TEST_MONGODB_URI=mongodb+srv://technogenius1500_db_user:ZnqBQD8wc4M6c1Fm@cluster0.slmyrux.mongodb.net/?appName=Cluster0_test
TEST_EMAIL=test@example.com

# ***************************************************************************************************
# MIGRATION AND SEEDING
# ***************************************************************************************************
RUN_MIGRATIONS_ON_START=true
SEED_DATABASE_ON_START=false
SEED_ADMIN_USER=true
SEED_SAMPLE_DATA=false

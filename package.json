{
  "name": "finautojobs",
  "version": "1.0.0",
  "description": "FinAutoJobs - Full Stack Job Portal Application",
  "main": "backend/server.js",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "install": "npm install --prefix backend && npm install --prefix frontend",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm install && npm run build",
    "start": "npm run start:backend",
    "start:backend": "cd backend && npm start",
    "start:production": "cd backend && NODE_ENV=production npm start",
    "deploy": "npm run build:frontend && npm run start:production",
    "postinstall": "echo 'Dependencies installed for both frontend and backend'",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "keywords": [
    "job-portal",
    "mern-stack",
    "express",
    "react",
    "vite",
    "mongodb",
    "careers",
    "fintech",
    "recruitment"
  ],
  "author": "FinAutoJobs Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/finautojobs.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/finautojobs/issues"
  },
  "homepage": "https://github.com/yourusername/finautojobs#readme"
}

# FinAutoJobs Enhanced Backend Environment Configuration

# ==============================================
# SERVER CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
MONGODB_URI=mongodb://localhost:27017/finauto_jobs

# MongoDB Connection Options
DB_MAX_POOL_SIZE=10
DB_SERVER_SELECTION_TIMEOUT=5000
DB_SOCKET_TIMEOUT=45000

# ==============================================
# JWT AUTHENTICATION
# ==============================================
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# ==============================================
# EMAIL SERVICE CONFIGURATION
# ==============================================
# Email Service Provider (gmail, sendgrid, ses, smtp)
EMAIL_SERVICE=gmail

# Gmail Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# SendGrid Configuration (Alternative)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Custom SMTP Configuration (Alternative)
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password

# Email Settings
EMAIL_FROM=noreply@finautojobs.com
EMAIL_FROM_NAME=FinAutoJobs

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================
# Maximum file size in bytes (10MB default)
MAX_FILE_SIZE=10485760

# Upload directory
UPLOAD_PATH=./uploads

# Allowed file types for resumes
ALLOWED_RESUME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Allowed image types for profiles
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Cloud Storage Configuration (Optional)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=finautojobs-uploads

# ==============================================
# REDIS CONFIGURATION (Optional)
# ==============================================
# Redis URL for caching and session storage
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=0

# ==============================================
# RATE LIMITING CONFIGURATION
# ==============================================
# General API rate limit (requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Authentication rate limit (requests per 15 minutes)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ==============================================
# SECURITY CONFIGURATION
# ==============================================
# Password requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# Account lockout settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000

# Session settings
SESSION_SECRET=your-session-secret-key
SESSION_MAX_AGE=86400000

# ==============================================
# NOTIFICATION CONFIGURATION
# ==============================================
# Push notification service (fcm, apns)
# PUSH_SERVICE=fcm
# FCM_SERVER_KEY=your-fcm-server-key
# FCM_PROJECT_ID=your-firebase-project-id

# Apple Push Notifications (for iOS)
# APNS_KEY_ID=your-apns-key-id
# APNS_TEAM_ID=your-team-id
# APNS_BUNDLE_ID=com.finautojobs.app
# APNS_PRIVATE_KEY_PATH=./certs/apns-private-key.p8

# ==============================================
# ANALYTICS CONFIGURATION
# ==============================================
# Google Analytics (Optional)
# GA_TRACKING_ID=UA-XXXXXXXXX-X

# Custom analytics settings
ANALYTICS_RETENTION_DAYS=365
CLEANUP_OLD_NOTIFICATIONS_DAYS=30

# ==============================================
# EXTERNAL SERVICES
# ==============================================
# Job board integrations
# INDEED_API_KEY=your-indeed-api-key
# LINKEDIN_API_KEY=your-linkedin-api-key

# Payment processing (for premium features)
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log file paths
LOG_FILE_PATH=./logs/app.log
ERROR_LOG_FILE_PATH=./logs/error.log

# ==============================================
# DEVELOPMENT TOOLS
# ==============================================
# Enable development features
ENABLE_CORS=true
ENABLE_MORGAN_LOGGING=true
ENABLE_DEBUG_MODE=false

# Test database (for running tests)
TEST_MONGODB_URI=mongodb://localhost:27017/finauto_jobs_test

# ==============================================
# PERFORMANCE CONFIGURATION
# ==============================================
# Compression settings
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6

# Cache settings
CACHE_TTL=3600
ENABLE_RESPONSE_CACHE=true

# ==============================================
# MONITORING & HEALTH CHECKS
# ==============================================
# Health check settings
HEALTH_CHECK_INTERVAL=30000
ENABLE_METRICS=true

# External monitoring services
# SENTRY_DSN=your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your-newrelic-license-key

# ==============================================
# BACKUP CONFIGURATION
# ==============================================
# Database backup settings
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=finautojobs-backups

# ==============================================
# FEATURE FLAGS
# ==============================================
# Enable/disable features
ENABLE_REAL_TIME_MESSAGING=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_FILE_UPLOADS=true
ENABLE_ANALYTICS_TRACKING=true
ENABLE_JOB_RECOMMENDATIONS=true
ENABLE_SKILL_ASSESSMENTS=false
ENABLE_VIDEO_INTERVIEWS=false

# ==============================================
# API VERSIONING
# ==============================================
# Default API version
DEFAULT_API_VERSION=v2
ENABLE_API_V1=true
ENABLE_API_V2=true

# ==============================================
# CORS CONFIGURATION
# ==============================================
# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://finautojobs.com

# Allowed methods
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Allowed headers
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# ==============================================
# SOCKET.IO CONFIGURATION
# ==============================================
# Socket.IO settings
SOCKET_IO_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SOCKET_IO_TRANSPORTS=websocket,polling
SOCKET_IO_PING_TIMEOUT=60000
SOCKET_IO_PING_INTERVAL=25000

# ==============================================
# SEARCH CONFIGURATION
# ==============================================
# Elasticsearch (Optional for advanced search)
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_INDEX=finautojobs

# Search settings
SEARCH_RESULTS_LIMIT=100
ENABLE_FUZZY_SEARCH=true

# ==============================================
# CONTENT MODERATION
# ==============================================
# Content filtering
ENABLE_CONTENT_MODERATION=true
PROFANITY_FILTER_ENABLED=true

# External moderation services
# PERSPECTIVE_API_KEY=your-perspective-api-key

# ==============================================
# LOCALIZATION
# ==============================================
# Default language
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it

# Timezone
DEFAULT_TIMEZONE=UTC

# ==============================================
# DEVELOPMENT DEBUGGING
# ==============================================
# Debug specific modules
DEBUG=app:*,socket.io:*

# Enable SQL query logging
ENABLE_QUERY_LOGGING=false

# Enable request/response logging
ENABLE_REQUEST_LOGGING=true

# ==============================================
# PRODUCTION OPTIMIZATIONS
# ==============================================
# Cluster mode (number of worker processes)
# CLUSTER_WORKERS=auto

# Memory limits
# MAX_MEMORY_USAGE=512

# Process management
# PM2_INSTANCES=max
# PM2_EXEC_MODE=cluster

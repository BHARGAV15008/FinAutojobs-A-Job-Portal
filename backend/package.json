{
  "name": "finautojobs-backend",
  "version": "1.0.0",
  "description": "FinAutoJobs Backend API",
  "main": "api/index.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "cd ../frontend && npm run build",
    "railway-build": "cd ../frontend && npm install && npm run build",
    "test": "mkdir -p ./data && cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "test:oauth": "node scripts/test-oauth.js",
    "check:oauth": "node scripts/check-oauth-config.js",
    "oauth:status": "node scripts/test-oauth.js --status",
    "oauth:config": "node scripts/check-oauth-config.js --deps"
  },
  "keywords": [
    "job-portal",
    "nodejs",
    "express",
    "drizzle-orm",
    "sqlite",
    "api",
    "backend"
  ],
  "author": "FinAutoJobs Team",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^24.5.2",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.4.1",
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.5.0",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.8.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.6",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-microsoft": "^2.1.0",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "socket.io": "^4.8.1",
    "twilio": "^5.10.2",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.6",
    "babel-jest": "^29.7.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/finautojobs/backend"
  },
  "bugs": {
    "url": "https://github.com/finautojobs/backend/issues"
  },
  "homepage": "https://github.com/finautojobs/backend#readme"
}

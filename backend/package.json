{
  "name": "finautojobs-backend",
  "version": "1.0.0",
  "description": "FinAutoJobs Backend API",
  "main": "api/index.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:tls-fix": "NODE_TLS_REJECT_UNAUTHORIZED=0 nodemon server.js",
    "start:tls-fix": "NODE_TLS_REJECT_UNAUTHORIZED=0 node server.js",
    "build": "cd ../frontend && npm run build",
    "test": "node -e \"require('fs').mkdirSync('./data', { recursive: true })\" && cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "test:oauth": "node scripts/test-oauth.js",
    "check:oauth": "node scripts/check-oauth-config.js",
    "oauth:status": "node scripts/test-oauth.js --status",
    "oauth:config": "node scripts/check-oauth-config.js --deps",
    "create:admin": "node scripts/create-super-admin.js",
    "create:admin:simple": "node scripts/create-admin-simple.js",
    "test:cors": "node scripts/test-cors.js",
    "test:admin": "node scripts/test-admin-login.js",
    "fix:admin": "node scripts/fix-admin-user.js",
    "test:backend": "node scripts/test-backend-login.js",
    "debug:admin": "node scripts/debug-admin-search.js",
    "fix:role": "node scripts/fix-admin-role.js",
    "cleanup:admin": "node scripts/cleanup-admin-users.js",
    "create:prod-admin": "node scripts/create-production-admin.js",
    "create:admins": "node create-admin-accounts.js",
    "list:admins": "node list-admin-accounts.js",
    "show:admins": "node show-admin-credentials.js",
    "create:simple-admin": "node scripts/create-simple-admin.js",
    "test:user-creds": "node scripts/test-user-credentials.js",
    "create:superadmin-faj": "node scripts/create-superadmin-finautojobs.js",
    "create:direct-admin": "node scripts/create-direct-admin.js",
    "test:exact-request": "node scripts/test-exact-request.js",
    "check:db-users": "node scripts/check-database-users.js",
    "create:multiple-admins": "node scripts/create-multiple-admins.js",
    "create:all-admin-types": "node scripts/create-all-admin-types.js",
    "test:analytics-admin": "node scripts/test-analytics-admin.js",
    "test:validation": "node scripts/test-validation-details.js",
    "create:simple-working-admin": "node scripts/create-simple-working-admin.js",
    "analyze:database": "node scripts/analyze-database-structure.js",
    "create:admin-baseusers": "node scripts/create-admin-in-baseusers.js",
    "debug:auth": "node scripts/debug-authentication-issue.js",
    "fix:admin-login": "node scripts/fix-admin-login-completely.js"
  },
  "keywords": [
    "job-portal",
    "nodejs",
    "express",
    "mongoose",
    "mongodb",
    "api",
    "backend"
  ],
  "author": "FinAutoJobs Team",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^24.5.2",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "dotenv": "^16.6.1",
    "empty-trash": "^4.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.5.0",
    "glob": "^11.0.3",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.8.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.4.3",
    "mongoose": "^8.19.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.6",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-linkedin-oauth2": "^2.0.0",
    "passport-local": "^1.0.0",
    "passport-microsoft": "^2.1.0",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "resend": "^6.1.2",
    "socket.io": "^4.8.1",
    "twilio": "^5.10.2",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "babel-jest": "^29.7.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/finautojobs/backend"
  },
  "bugs": {
    "url": "https://github.com/finautojobs/backend/issues"
  },
  "homepage": "https://github.com/finautojobs/backend#readme"
}

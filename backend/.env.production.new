# =============================================================================
# FinAutoJobs Backend - Production Configuration
# =============================================================================
# Use this configuration for production deployment (Render, Railway, etc.)

# Server Configuration
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# Database Configuration - Use MongoDB Atlas for production
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/finautojobs?retryWrites=true&w=majority

# Frontend URL - Update with your production domain
FRONTEND_URL=https://your-frontend-domain.com

# CORS Origins - Production domains
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Security Configuration - GENERATE STRONG SECRETS!
SESSION_SECRET=your-super-strong-session-secret-for-production-min-32-chars
JWT_SECRET=your-super-strong-jwt-secret-for-production-min-32-chars
JWT_REFRESH_SECRET=your-super-strong-refresh-secret-for-production-min-32-chars
JWT_EXPIRES_IN=24h

# Email Configuration - Use production email service
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-production-email@gmail.com
EMAIL_PASS=your-production-app-password
EMAIL_FROM="FinAutoJobs" <noreply@your-domain.com>

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Rate Limiting - Stricter for production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# WebSocket Configuration
WEBSOCKET_ENABLED=true

# OAuth Configuration - Production credentials
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
MICROSOFT_CLIENT_ID=your-production-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-production-microsoft-client-secret

# Security Settings
BCRYPT_ROUNDS=12
ENABLE_ANALYTICS=true
LOG_LEVEL=info

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379

# =============================================================================
# DEPLOYMENT CHECKLIST:
# =============================================================================
# ✅ Update MONGODB_URI with MongoDB Atlas connection string
# ✅ Update FRONTEND_URL with your production domain
# ✅ Update CORS_ORIGINS with your production domains
# ✅ Generate strong, unique secrets (min 32 characters)
# ✅ Configure production email credentials
# ✅ Set up OAuth provider credentials for production
# ✅ Configure environment variables in your hosting platform
# ✅ Test all endpoints after deployment
# =============================================================================
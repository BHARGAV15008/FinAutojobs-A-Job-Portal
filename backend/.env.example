# =============================================================================
# FinAutoJobs Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION (MongoDB)
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/finautojobs

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-123456789
JWT_EXPIRES_IN=24h

# =============================================================================
# SESSION CONFIGURATION

# CORS Origins (for development)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase Configuration (for Phone Authentication)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM_NAME=FinAutoJobs
EMAIL_FROM_ADDRESS=your-email@gmail.com

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://finautojobs-a-job-portal-hk5c.onrender.com/api/oauth/google/callback

# Session Configuration
SESSION_SECRET=your-session-secret-key-change-this-in-production
APPLE_TEAM_ID=your-apple-team-id

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================
{{ ... }}
ADMIN_NAME=Super Admin

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log

# =============================================================================
# CACHE CONFIGURATION (Redis - Optional)
# =============================================================================
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# =============================================================================
# ANALYTICS CONFIGURATION (Optional)
# =============================================================================
# GOOGLE_ANALYTICS_ID=your-ga-tracking-id
# MIXPANEL_TOKEN=your-mixpanel-token

# =============================================================================
# DEVELOPMENT FLAGS
# =============================================================================
# Enable/disable email sending in development
SEND_EMAILS_IN_DEV=true

# Enable/disable real-time notifications
ENABLE_SOCKET_IO=true

# Enable/disable detailed error logging
DEBUG_MODE=true

# =============================================================================
# PRODUCTION SECURITY HEADERS
# =============================================================================
# Content Security Policy
CSP_DEFAULT_SRC="'self'"
CSP_SCRIPT_SRC="'self' 'unsafe-inline' 'unsafe-eval'"
CSP_STYLE_SRC="'self' 'unsafe-inline'"
CSP_IMG_SRC="'self' data: https:"
CSP_FONT_SRC="'self' data: https:"
CSP_CONNECT_SRC="'self' ws: wss:"

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable user registration
ENABLE_REGISTRATION=true

# Enable/disable company verification
ENABLE_COMPANY_VERIFICATION=true

# Enable/disable job posting for unverified companies
ALLOW_UNVERIFIED_JOB_POSTING=false

# Enable/disable applicant profile completion
REQUIRE_PROFILE_COMPLETION=true

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Database connection pool settings
DB_POOL_SIZE=10
DB_POOL_MAX_WAITING_TIME=30000

# API pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================
# Push notification service (optional)
# FCM_SERVER_KEY=your-fcm-server-key
# FCM_SENDER_ID=your-fcm-sender-id

# SMS service (optional)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Database backup settings
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *  # At 2:00 AM every day
# BACKUP_RETENTION_DAYS=30
# BACKUP_STORAGE_PATH=./backups

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Application monitoring (optional)
# SENTRY_DSN=your-sentry-dsn
# DATADOG_API_KEY=your-datadog-api-key
# NEW_RELIC_LICENSE_KEY=your-new-relic-license-key

# Health check endpoints
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# =============================================================================
# LEGAL AND COMPLIANCE
# =============================================================================
# Data retention policy
DATA_RETENTION_DAYS=365

# GDPR compliance
ENABLE_DATA_EXPORT=true
ENABLE_DATA_DELETION=true
AUTO_DELETE_INACTIVE_ACCOUNTS=true
INACTIVE_ACCOUNT_DAYS=365

# =============================================================================
# CUSTOMIZATION
# =============================================================================
# Platform name and branding
PLATFORM_NAME=FinAutoJobs
PLATFORM_TAGLINE=Connecting Talent with Opportunity
PLATFORM_LOGO=/assets/logo.png
PLATFORM_FAVICON=/assets/favicon.ico

# Support contact
SUPPORT_EMAIL=support@finautojobs.com
SUPPORT_PHONE=+1-555-123-4567

# Social media links
SOCIAL_FACEBOOK=https://facebook.com/finautojobs
SOCIAL_TWITTER=https://twitter.com/finautojobs
SOCIAL_LINKEDIN=https://linkedin.com/company/finautojobs
SOCIAL_INSTAGRAM=https://instagram.com/finautojobs

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# Test database (for automated testing)
TEST_MONGODB_URI=mongodb://localhost:27017/finautojobs_test

# Test email (for development/testing)
TEST_EMAIL=test@example.com

# =============================================================================
# MIGRATION AND SEEDING
# =============================================================================
# Run database migrations on startup
RUN_MIGRATIONS_ON_START=true

# Seed database with initial data
SEED_DATABASE_ON_START=false
SEED_ADMIN_USER=true
SEED_SAMPLE_DATA=false

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
# Make sure to restart the server after changing any of these values
# =============================================================================

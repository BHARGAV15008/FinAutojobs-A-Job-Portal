# Backend Environment Variables
# Copy this to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL - AUTO-DETECTED by default
# The application automatically detects your network IP address
# Leave blank for automatic detection (recommended for development)
# FRONTEND_URL=
# 
# For production deployments, set explicitly:
# FRONTEND_URL=https://your-domain.com
FRONTEND_URL=

# CORS Origins - AUTO-GENERATED by default
# Additional origins can be added as comma-separated list
# Leave blank for automatic configuration (recommended)
# CORS_ORIGIN=
# 
# Add custom domains if needed:
# CORS_ORIGIN=https://custom-domain.com,https://another-domain.com
CORS_ORIGIN=

# Database
# MongoDB Atlas Connection String (Updated - Working Cluster)
# IMPORTANT: Replace <username>, <password>, and <cluster> with your actual MongoDB Atlas credentials
# Example: mongodb+srv://myuser:mypass@cluster0.xxxxx.mongodb.net/finautojobs
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/finautojobs?retryWrites=true&w=majority&appName=Cluster0

# JWT
# IMPORTANT: Generate secure random strings for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<your-secure-jwt-secret-minimum-32-characters>
JWT_EXPIRES_IN=24h
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Callback URL - AUTO-GENERATED by default
# Leave blank for automatic detection
# GOOGLE_CALLBACK_URL=
# 
# For production, set explicitly:
# GOOGLE_CALLBACK_URL=https://your-backend-domain.com/api/oauth/google/callback
GOOGLE_CALLBACK_URL=

# For production, use:
# For Gmail: Use App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=<your-email>@gmail.com
EMAIL_PASS=<your-gmail-app-password>
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Backend Environment Variables
# Copy this to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL - Update this for cross-device access
# For localhost only: http://localhost:3000
# For same network access: http://YOUR_LOCAL_IP:3000 (e.g., http://192.168.1.100:3000)
FRONTEND_URL=http://localhost:3000

# CORS Origins - Add your local IP for cross-device access
# Example: http://192.168.1.100:3000,http://localhost:3000
CORS_ORIGIN=http://localhost:3000


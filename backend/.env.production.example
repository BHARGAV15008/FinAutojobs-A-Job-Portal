# Production Backend Environment Configuration
# Copy this to .env.production for production deployment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# Frontend URL - CRITICAL: Update this to your frontend domain
# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Production MongoDB URI - Use MongoDB Atlas or your production database
MONGODB_URI=mongodb+srv://technogenius1500_db_user:fJZL9rXdCeOc7AFh@cluster0.owb8igw.mongodb.net/finautojobs?retryWrites=true&w=majority&appName=Cluster0

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# CRITICAL: Generate strong secrets for production
JWT_SECRET=8f69bcf03020571977a802457bd0ff26edce2f7cd0e7519a80c3342f379d2c59
SESSION_SECRET=d32bb7935507c520472afab198fccdc4e6f9ee12fb25203d9ec953c81d811363
# JWT Configuration
JWT_EXPIRES_IN=24h

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Main frontend URL
CORS_ORIGIN=https://your-frontend-domain.com

# Additional allowed patterns (comma-separated)
CORS_ALLOW_PATTERNS=your-domain.com

# =============================================================================
# EMAIL CONFIGURATION (Production SMTP)
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-production-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM_NAME=FinAutoJobs
EMAIL_FROM_ADDRESS=noreply@finautojobs.com

# =============================================================================
# OAUTH CONFIGURATION
# =============================================================================
# Google OAuth (Production)
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-domain.com/api/oauth/google/callback

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_REGISTRATION=true
ENABLE_COMPANY_VERIFICATION=true
ALLOW_UNVERIFIED_JOB_POSTING=false
REQUIRE_PROFILE_COMPLETION=true
SEND_EMAILS_IN_DEV=false
ENABLE_SOCKET_IO=true
DEBUG_MODE=false

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
DB_POOL_SIZE=10
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
LOG_LEVEL=info
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# =============================================================================
# DEPLOYMENT PLATFORM EXAMPLES
# =============================================================================

# Render.com Example:
# FRONTEND_URL=https://finautojobs.onrender.com
# CORS_ORIGIN=https://finautojobs.onrender.com
# GOOGLE_REDIRECT_URI=https://finautojobs-api.onrender.com/api/oauth/google/callback

# Railway Example:
# FRONTEND_URL=https://finautojobs.railway.app
# CORS_ORIGIN=https://finautojobs.railway.app
# GOOGLE_REDIRECT_URI=https://finautojobs-api.railway.app/api/oauth/google/callback

# Vercel + Heroku Example:
# FRONTEND_URL=https://finautojobs.vercel.app
# CORS_ORIGIN=https://finautojobs.vercel.app
# GOOGLE_REDIRECT_URI=https://finautojobs-api.herokuapp.com/api/oauth/google/callback

# Custom Domain Example:
# FRONTEND_URL=https://finautojobs.com
# CORS_ORIGIN=https://finautojobs.com
# GOOGLE_REDIRECT_URI=https://api.finautojobs.com/api/oauth/google/callback

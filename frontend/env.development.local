# Local Development Environment
# This file overrides the deployed backend URL for local development

# Use local backend for development
VITE_API_URL=http://localhost:5000/api

# Application Configuration
VITE_APP_NAME=FinAutoJobs (Development)
VITE_NODE_ENV=development

# Debug Mode
VITE_DEBUG=true

# Feature Flags
VITE_ENABLE_REAL_TIME_NOTIFICATIONS=true
VITE_ENABLE_FILE_UPLOADS=true
VITE_ENABLE_SOCIAL_LOGIN=true
VITE_ENABLE_PREMIUM_FEATURES=false

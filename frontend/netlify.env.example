# Frontend Environment Variables for Netlify
# Copy these to your Netlify site settings

# API Configuration
VITE_API_URL=https://your-site-name.netlify.app/.netlify/functions/api
VITE_APP_NAME=FinAutoJobs
VITE_NODE_ENV=production

# Feature Flags
VITE_ENABLE_REAL_TIME_NOTIFICATIONS=true
VITE_ENABLE_FILE_UPLOADS=true
VITE_ENABLE_SOCIAL_LOGIN=true
VITE_ENABLE_PREMIUM_FEATURES=false

# Debug (set to false in production)
VITE_DEBUG=false

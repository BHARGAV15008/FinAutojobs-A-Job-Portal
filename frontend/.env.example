# Frontend Environment Variables
# Copy this to .env.local and fill in your actual values

# API URL - Update this for cross-device access
# For localhost only: http://localhost:5000/api
# For same network access: http://YOUR_LOCAL_IP:5000/api (e.g., http://192.168.1.100:5000/api)
VITE_API_URL=http://localhost:5000/api

# App Configuration
VITE_APP_NAME=FinAutoJobs
VITE_APP_VERSION=1.0.0
VITE_NODE_ENV=development

# ============================================
# CROSS-DEVICE ACCESS SETUP INSTRUCTIONS
# ============================================
#
# To access the app from other devices on the same network:
#
# 1. Find your computer's local IP address:
#    - Windows: Open CMD and run: ipconfig
#      Look for "IPv4 Address" (e.g., 192.168.1.100)
#    - Mac/Linux: Open Terminal and run: ifconfig or ip addr
#      Look for "inet" address (e.g., 192.168.1.100)
#
# 2. Update this file:
#    VITE_API_URL=http://YOUR_LOCAL_IP:5000/api
#    Example: VITE_API_URL=http://192.168.1.100:5000/api
#
# 3. Update backend/.env with:
#    FRONTEND_URL=http://YOUR_LOCAL_IP:3000
#    CORS_ORIGIN=http://YOUR_LOCAL_IP:3000,http://localhost:3000
#
# 4. Restart both servers:
#    - Backend: npm run dev (in backend folder)
#    - Frontend: npm run dev (in frontend folder)
#
# 5. Access from other devices:
#    Open browser and go to: http://YOUR_LOCAL_IP:3000
#    Example: http://192.168.1.100:3000
#
# Note: Make sure your firewall allows connections on ports 3000 and 5000
#

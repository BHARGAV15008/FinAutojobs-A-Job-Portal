# Production Environment Configuration
# Copy this to .env.production for production builds

# API Configuration - CRITICAL: Update these for your deployment
VITE_API_URL=https://your-backend-domain.com/api

# Application Info
VITE_APP_NAME=FinAutoJobs
VITE_APP_VERSION=1.0.0
VITE_NODE_ENV=production

# Feature Flags
VITE_ENABLE_REAL_TIME_NOTIFICATIONS=true
VITE_ENABLE_FILE_UPLOADS=true
VITE_ENABLE_SOCIAL_LOGIN=true
VITE_ENABLE_PREMIUM_FEATURES=true

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Social Login (Optional)
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Performance
VITE_DEBUG=false

# Common Production URLs (examples):
# Render.com: https://your-backend-name.onrender.com/api
# Railway: https://your-backend-name.railway.app/api  
# Heroku: https://your-backend-name.herokuapp.com/api
# Vercel: https://your-backend-name.vercel.app/api
# Netlify Functions: https://your-site.netlify.app/.netlify/functions/api

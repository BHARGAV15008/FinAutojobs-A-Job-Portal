# Frontend Production Environment Variables for Vercel

# API Base URL - Vercel will handle this automatically
VITE_API_BASE_URL=/api

# App Configuration
VITE_APP_NAME=FinAutoJobs
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Professional Job Portal Platform

# Feature Flags
VITE_ENABLE_OAUTH=true
VITE_ENABLE_PHONE_AUTH=true
VITE_ENABLE_SMS_OTP=true
VITE_ENABLE_FILE_UPLOAD=true
VITE_ENABLE_REAL_TIME_NOTIFICATIONS=true

# External Services
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_MICROSOFT_CLIENT_ID=your-microsoft-client-id
VITE_APPLE_CLIENT_ID=your-apple-client-id

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Socket.IO Configuration
VITE_SOCKET_IO_URL=/

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=your-google-analytics-id

# Error Tracking (Optional)
VITE_SENTRY_DSN=your-sentry-dsn

# Social Media Links
VITE_FACEBOOK_URL=https://facebook.com/your-page
VITE_TWITTER_URL=https://twitter.com/your-handle
VITE_LINKEDIN_URL=https://linkedin.com/company/your-company
VITE_INSTAGRAM_URL=https://instagram.com/your-handle

# Contact Information
VITE_CONTACT_EMAIL=contact@finautojobs.com
VITE_CONTACT_PHONE=+1234567890
VITE_SUPPORT_EMAIL=support@finautojobs.com

# Company Information
VITE_COMPANY_NAME=FinAutoJobs
VITE_COMPANY_ADDRESS=Your Company Address
VITE_COMPANY_WEBSITE=https://finautojobs.com

# App Settings
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf
VITE_OTP_LENGTH=6
VITE_OTP_EXPIRY_MINUTES=10

# Development/Production Flags
VITE_NODE_ENV=production
VITE_DEBUG=false
VITE_LOG_LEVEL=error
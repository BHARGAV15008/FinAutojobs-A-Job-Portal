# Staging Environment Configuration
# Copy this to .env.staging for staging builds

# API Configuration - Update for your staging deployment
VITE_API_URL=https://staging-your-backend.com/api

# Application Info
VITE_APP_NAME=FinAutoJobs (Staging)
VITE_APP_VERSION=1.0.0-staging
VITE_NODE_ENV=staging

# Feature Flags (can enable experimental features)
VITE_ENABLE_REAL_TIME_NOTIFICATIONS=true
VITE_ENABLE_FILE_UPLOADS=true
VITE_ENABLE_SOCIAL_LOGIN=true
VITE_ENABLE_PREMIUM_FEATURES=false

# Debug (can be enabled for staging)
VITE_DEBUG=true

# Common Staging URLs (examples):
# Render.com: https://staging-your-backend.onrender.com/api
# Railway: https://staging-your-backend.railway.app/api  
# Heroku: https://staging-your-backend.herokuapp.com/api
# Vercel: https://staging-your-backend.vercel.app/api
